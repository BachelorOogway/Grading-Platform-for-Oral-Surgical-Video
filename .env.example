# Local Postgres / Neon. On Vercel, Neon Storage injects these automatically.
# DATABASE_URL = pooled (app runtime). DATABASE_URL_UNPOOLED = direct (Prisma migrate).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required on Vercel / production. Protects /admin and all /api/admin/* routes.
# Generate a long random string, e.g. openssl rand -hex 32
ADMIN_SECRET=""

# Production default: expert self-registration is OFF on Vercel.
# Set to "true" only if you intentionally allow anyone to create expert accounts.
# ALLOW_EXPERT_SELF_REGISTER="false"
