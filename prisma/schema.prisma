generator client {
  provider      = "prisma-client-js"
  // native = local; rhel-openssl-3.0.x = Vercel Node runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime: use pooled DATABASE_URL (Neon / Vercel injects this)
  url       = env("DATABASE_URL")
  // Migrations: use direct connection (Neon injects DATABASE_URL_UNPOOLED)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model AssignmentConfig {
  id              String   @id @default("default")
  // JSON string: [{ "start": 1, "end": 75 }, ...]
  exclusiveRanges String
  // JSON string: [{ "start": 76, "end": 99 }, ...]
  sharedRanges    String
  updatedAt       DateTime @updatedAt
}

model Expert {
  id           String           @id @default(cuid())
  expertId     String           @unique
  name         String
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignments  TaskAssignment[]
  grading      GradingResult[]

  @@index([name])
}

model AiOutput {
  id            String   @id @default(cuid())
  videoOutputId String   @unique
  rawText       String
  // JSON string of parsed AI output
  parsedData    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments   TaskAssignment[]
  grading       GradingResult[]
  discrepancies DiscrepancyItem[]

  @@index([createdAt])
}

model TaskAssignment {
  id         String   @id @default(cuid())
  expertId   String
  aiOutputId String
  // EXCLUSIVE | SHARED
  kind       String   @default("EXCLUSIVE")
  // PENDING | COMPLETED
  status     String   @default("PENDING")
  // 1 | 2 | 3 — order among graders for this video
  graderSlot Int      @default(1)
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Admin requested regrade
  regradeNote        String?
  regradeRequestedAt DateTime?

  expert        Expert         @relation(fields: [expertId], references: [id])
  aiOutput      AiOutput       @relation(fields: [aiOutputId], references: [id])
  gradingResult GradingResult?

  @@unique([expertId, aiOutputId])
  @@index([status])
  @@index([aiOutputId, graderSlot])
}

model GradingResult {
  id               String   @id @default(cuid())
  taskAssignmentId String   @unique
  expertId         String
  aiOutputId       String
  // JSON string of grading form answers
  gradingData      String
  submittedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  taskAssignment TaskAssignment @relation(fields: [taskAssignmentId], references: [id], onDelete: Cascade)
  expert         Expert         @relation(fields: [expertId], references: [id])
  aiOutput       AiOutput       @relation(fields: [aiOutputId], references: [id])

  @@index([submittedAt])
  @@index([expertId])
  @@index([aiOutputId])
}

// Open discrepancy-solve item on a categorical field (no voting; excluded from 2:1 majority).
model DiscrepancyItem {
  id              String   @id @default(cuid())
  aiOutputId      String
  fieldPath       String
  fieldLabel      String
  status          String   @default("OPEN") // OPEN | RESOLVED
  resolvedValue   String?
  createdByExpert String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aiOutput AiOutput          @relation(fields: [aiOutputId], references: [id])
  votes    DiscrepancyVote[]

  @@unique([aiOutputId, fieldPath])
  @@index([status])
}

model DiscrepancyVote {
  id                String   @id @default(cuid())
  discrepancyItemId String
  expertId          String
  choice            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item DiscrepancyItem @relation(fields: [discrepancyItemId], references: [id], onDelete: Cascade)

  @@unique([discrepancyItemId, expertId])
}
